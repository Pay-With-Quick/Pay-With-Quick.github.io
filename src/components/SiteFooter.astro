---
import { navLinks, site } from "../content/site.js";
---

<footer class="site-footer">
  <div class="site-footer-bg" aria-hidden="true">
    <img
      src="/images/adobestock_496109332-convertito-1.jpg"
      alt=""
      width="1920"
      height="1280"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="site-footer-overlay" aria-hidden="true"></div>
  <div class="container site-footer-content">
    <div class="footer-grid">
      <section>
        <a class="footer-brand" href="/">
          <img src="/images/5c.png" alt="Quick mark" width="70" height="70" loading="lazy" decoding="async" />
          <span>{site.name}</span>
        </a>
        <p class="footer-copy">Instant, secure, bank-to-bank payments built for modern merchants.</p>
      </section>

      <section>
        <h3>Quick links</h3>
        <ul class="footer-links">
          {
            navLinks.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
          <li><a href="/docs/">Docs</a></li>
        </ul>
      </section>

      <section>
        <h3>Contact</h3>
        <p>{site.address}</p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p><a href="tel:+447786088188">{site.phone}</a></p>
      </section>

      <section>
        <h3>Legal</h3>
        <ul class="footer-links">
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/cookie-policy/">Cookie Policy</a></li>
          <li><a href="#" id="open-cookie-settings">Cookie settings</a></li>
        </ul>
      </section>
    </div>
  </div>
</footer>

<script>
  const cookieSettingsLink = document.getElementById("open-cookie-settings");
  if (cookieSettingsLink) {
    cookieSettingsLink.addEventListener("click", (event) => {
      event.preventDefault();
      window.dispatchEvent(new Event("quick:open-cookie-settings"));
    });
  }
</script>

<style>
  .site-footer {
    margin-top: 3rem;
    position: relative;
    color: #ffffff;
    overflow: hidden;
  }

  .site-footer-bg,
  .site-footer-overlay {
    position: absolute;
    inset: 0;
  }

  .site-footer-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .site-footer-overlay {
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.92), rgba(30, 41, 135, 0.72));
  }

  .site-footer-content {
    position: relative;
    z-index: 1;
    padding: 2.2rem 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 1.4fr 1fr 0.9fr;
    gap: 1.2rem;
    align-items: start;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: #ffffff;
    text-decoration: none;
    font-size: 1.4rem;
    font-weight: 800;
    margin-bottom: 0.3rem;
  }

  .footer-copy {
    max-width: 30ch;
  }

  .footer-brand img {
    width: 52px;
    height: 52px;
    border-radius: 12px;
  }

  .site-footer p {
    margin: 0.4rem 0;
    color: rgba(255, 255, 255, 0.92);
  }

  .site-footer a {
    color: #ffffff;
  }

  .site-footer h3 {
    margin: 0 0 0.7rem;
    font-size: 1rem;
    color: #dbe4ff;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.75rem;
    align-items: center;
  }

  .footer-links a {
    text-decoration: underline;
    text-underline-offset: 3px;
    color: rgba(255, 255, 255, 0.92);
    padding: 0;
    border-radius: 0;
    border: 0;
    font-size: 0.95rem;
  }

  .footer-links a:hover {
    color: #ffffff;
    opacity: 0.9;
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
